# --- Database ---
# Matches docker-compose.yml postgres service by default
DATABASE_URL="postgresql://zen:zen_dev_password@localhost:5432/zen_knowledge"

# --- Auth.js (NextAuth) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- LLM generation (Groq) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY="gsk_replace_me"
GROQ_MODEL="openai/gpt-oss-120b"

# --- Internal automation (n8n callbacks) ---
# Shared secret n8n sends in the X-Internal-Secret header when calling
# /api/internal/* routes. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET="replace-with-a-random-secret"

# Base URL n8n uses to reach this app (in docker-compose, the app runs on the
# host, so n8n calls host.docker.internal; in production, your public app URL)
APP_BASE_URL="http://host.docker.internal:3000"

# --- File storage ---
# Local filesystem path where uploaded documents are stored.
# Swap for an S3StorageProvider + bucket name if you later move to S3.
STORAGE_DIR="./storage"

# --- Retrieval tuning ---
# Minimum cosine similarity to accept a retrieved chunk as a valid source.
# See src/lib/env.ts for why this is a measured middle ground, not a precise
# boundary, with Xenova/all-MiniLM-L6-v2 on French text.
RETRIEVAL_MIN_SIMILARITY="0.45"
RETRIEVAL_TOP_K="6"
